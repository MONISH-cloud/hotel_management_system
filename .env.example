# Copy this file to .env.local and replace every 'change-me...' value. The app refuses to start with placeholders.
# Generate a secret:  openssl rand -hex 32   (PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_}))

# ---- MySQL (core relational store) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=maison_aurelia
MYSQL_USER=hotel_app
MYSQL_PASSWORD=change-me-choose-a-password
# privileged account used ONLY by scripts/setup-db.mjs to create the schema
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=

# ---- Neo4j (graph NoSQL: reviews + recommendations) ----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# ---- Redis (sessions, cache, rate limit, wishlist, live feed) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# Set to 1 only if MySQL runs in Docker/WSL (lets the app user connect from the container gateway)
# MYSQL_ALLOW_ANY_HOST=1

# Optional: real email delivery. Without these, emails are recorded in the email_outbox table.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Hotel <stay@example.com>"
# Public URL used in email links (defaults to the request origin)
# APP_URL=http://localhost:3000
